// ─────────────────────────────────────────────────────────────────────────────
// Seller Marketplace — data model
//
// Multi-tenancy: shared database, shared schema. The tenant is the `Seller`.
// Every seller-owned model carries `sellerId`, and every index serving a
// seller-scoped query leads with it. Slugs are unique WITHIN a tenant, not
// globally — see @@unique([sellerId, slug]).
//
// Money is stored as integer minor units (paise/cents) plus a currency code.
// Never Float. See src/lib/utils/money.ts.
//
// Postgres extensions (citext, pg_trgm, unaccent) and everything Prisma cannot
// express — generated tsvector columns, CHECK constraints, partial indexes,
// table partitioning — live in prisma/migrations/*/migration.sql.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════ ENUMS ════════════════════════════════════════

enum UserRole {
  BUYER
  SELLER_OWNER
  SELLER_STAFF
  SUPPORT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum SellerStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
  BANNED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  LOCALITY
}

enum EnquiryStatus {
  NEW
  VIEWED
  RESPONDED
  CONVERTED
  CLOSED
  SPAM
}

enum EnquirySource {
  MARKETPLACE_PRODUCT
  MARKETPLACE_SELLER
  MICROSITE_CONTACT
  MICROSITE_PRODUCT
  WHATSAPP_CLICK
  PHONE_REVEAL
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// What a plan buys on the web (decision D32). Ordered: each tier includes
/// the ones before it.
///   CATALOGUE      marketplace listing + catalogue page on the apex only
///   SUBDOMAIN      + a website at {slug}.bzaro.in
///   CUSTOM_DOMAIN  + that website on the seller's own domain (D3, Phase 10)
enum WebPresence {
  CATALOGUE
  SUBDOMAIN
  CUSTOM_DOMAIN
}

enum MediaProvider {
  CLOUDINARY
  S3
}

enum DomainStatus {
  NONE
  PENDING_DNS
  VERIFYING
  ACTIVE
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  GSTIN
  PAN
  BUSINESS_REG
  ADDRESS_PROOF
  OTHER
}

// ── Discovery & leads ────────────────────────────────────────────────────────
// State machines and masking rules are documented in docs/LEADS.md.

enum BusinessType {
  MANUFACTURER
  WHOLESALER
  DISTRIBUTOR
  TRADER
  RETAILER
  SERVICE_PROVIDER
  EXPORTER
}

enum OnboardingStep {
  ACCOUNT
  BUSINESS
  TRUST
  /// Pick a website template (D33). Sits between TRUST and CATALOG.
  THEME
  CATALOG
  COMPLETE
}

/// Phone OTP. Buyers no longer use this path — they authenticate with email and
/// password (see EmailOtp), so the only remaining purpose is the seller's
/// onboarding mobile check.
enum OtpPurpose {
  /// Seller onboarding step 1, mobile verification.
  SELLER_SIGNUP
}

/// Email OTP, the buyer's verification channel. Sent via Resend.
enum EmailOtpPurpose {
  SIGNUP
  RESET_PASSWORD
}

enum RequirementTimeline {
  IMMEDIATE
  WITHIN_WEEK
  WITHIN_MONTH
  EXPLORING
}

enum RequirementPurpose {
  RESALE
  BUSINESS_USE
  PERSONAL_USE
}

/// Which control the buyer pressed. Drives what happens after submit: CALL
/// reveals the seller's number, WHATSAPP opens wa.me with a prefilled message.
enum RequirementTrigger {
  CALL
  WHATSAPP
  ENQUIRY
  SEARCH_CARD
}

/// Where the requirement was raised. Attribution, not routing.
enum RequirementSource {
  BZARO_MARKETPLACE
  STOREFRONT
}

/// Async fan-out state. The request that creates a Requirement only ever
/// writes PENDING; the worker owns every other transition.
enum FanoutStatus {
  PENDING
  RUNNING
  DONE
  /// 7-day duplicate rule, or no eligible sellers.
  SKIPPED
  FAILED
}

enum LeadType {
  DIRECT
  MARKET
}

/// CLOSED and EXPIRED are terminal states owned by the seller and the sweeper
/// respectively; CONTACTED / WON / LOST are the seller's own progress markers
/// after acceptance. See docs/LEADS.md §2.
enum LeadStatus {
  NEW
  VIEWED
  ACCEPTED
  CONTACTED
  WON
  LOST
  CLOSED
  EXPIRED
}

enum LeadChannel {
  PANEL
  WHATSAPP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum CreditReason {
  MONTHLY_GRANT
  LEAD_ACCEPT
  FLAG_REFUND
  ADMIN_ADJUST
}

enum LeadFlagReason {
  UNREACHABLE
  WRONG_CATEGORY
  WRONG_CITY
  DUPLICATE
  SPAM
  OTHER
}

enum LeadFlagStatus {
  OPEN
  REFUNDED
  REJECTED
}

// ── Commerce (storefronts only) ──────────────────────────────────────────────
// Carts, orders and the seller-owned payment / shipping integrations behind
// them. Never available on the apex — see docs/MULTI_TENANCY.md.

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingStatus {
  NOT_SHIPPED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum IntegrationType {
  RAZORPAY
  SHIPROCKET
}

enum IntegrationMode {
  TEST
  LIVE
}

/// Why a seller has a feature. ADMIN_OVERRIDE outranks the plan and is never
/// revoked by a subscription sweep.
enum FeatureSource {
  PLAN
  ADDON
  ADMIN_OVERRIDE
}

// ═══════════════════════ IDENTITY & ACCESS ═══════════════════════════════════

model User {
  id                   String    @id @default(cuid())
  email                String    @unique @db.Citext
  emailVerified        DateTime?
  passwordHash         String?
  name                 String?
  phone                String?   @unique
  phoneVerified        DateTime?
  /// Collected at seller sign-up step 1 (docs/LEADS.md onboarding); copied to
  /// Seller.whatsapp when the business is created.
  whatsapp             String?
  image                String?
  role                 UserRole  @default(BUYER)
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  failedLogins         Int       @default(0)
  lockedUntil          DateTime?
  /// Immediate session revocation. Auth.js cannot combine the Credentials
  /// provider with database sessions, so sessions are JWT-backed; any token
  /// issued before this timestamp is rejected. Set on suspend, ban, role
  /// change, password reset, and "sign out everywhere".
  /// See docs/SECURITY.md §Sessions.
  sessionsInvalidAfter DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  accounts    Account[]
  sessions    Session[]
  memberships SellerMember[]
  reviews     Review[]
  auditLogs   AuditLog[]
  /// Buyer-side location and preferences. Present once the user acts as a
  /// buyer; identity itself (email, password, phone) lives on this row.
  buyerProfile BuyerProfile?
  requirements Requirement[]
  carts        Cart[]
  orders       Order[]
  savedSellers SavedSeller[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Join table between User and Seller. Exists from day one so seller staff
/// accounts arrive later as a feature, not a migration.
model SellerMember {
  id        String   @id @default(cuid())
  userId    String
  sellerId  String
  role      UserRole @default(SELLER_OWNER)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerId])
  @@index([sellerId])
}

// ══════════════════════════════ TENANT ═══════════════════════════════════════

model Seller {
  id           String       @id @default(cuid())
  /// Doubles as the subdomain label. Validated against the reserved list in
  /// src/lib/tenant/reserved.ts. Must never contain a dot — wildcard TLS
  /// certificates cover exactly one label.
  slug         String       @unique @db.Citext
  businessName String
  legalName    String?
  tagline      String?
  description  String?      @db.Text
  status       SellerStatus @default(DRAFT)

  // Branding
  logoUrl       String?
  coverImageUrl String?

  // Contact — phone numbers stored E.164 (+919876543210)
  email      String? @db.Citext
  phone      String?
  whatsapp   String?
  websiteUrl String?

  // Address
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  locationId   String?
  latitude     Float?
  longitude    Float?

  // Business metadata
  establishedYear Int?
  employeeCount   String?
  gstin           String? @unique
  pan             String?
  /// { mon: [{ open: "09:00", close: "18:00" }], ... } — validated by Zod.
  businessHours   Json?
  timezone        String  @default("Asia/Kolkata")
  locale          String  @default("en")
  /// { facebook, instagram, linkedin, youtube, x } — validated by Zod.
  socialLinks     Json?

  // Denormalised counters. Maintained in the service layer inside the same
  // transaction as the write; reconciled nightly by refresh-counters.
  productCount Int   @default(0)
  serviceCount Int   @default(0)
  ratingAvg    Float @default(0)
  ratingCount  Int   @default(0)
  /// 0-100 profile completeness. Drives the indexability gate (decision D2).
  profileScore Int   @default(0)

  // Onboarding (multi-step, see src/lib/onboarding). Step 2 = business,
  // step 3 = trust. employeeCount / establishedYear / gstin / logoUrl above
  // already belong to those steps; photos reuse GalleryItem.
  businessType    BusinessType?
  onboardingStep  OnboardingStep @default(ACCOUNT)
  /// Bucket label from a fixed list, e.g. "1-5 Cr". Never a number.
  annualTurnover  String?
  /// From a fixed list: ["ISO 9001", "MSME", ...]. Validated by Zod.
  certifications  String[]
  gstinVerifiedAt DateTime?

  // Lead-matching signals. Denormalised, maintained in the same transaction as
  // the lead write; reconciled nightly by refresh-lead-stats.
  /// 0..1. Null = "no history yet" → the matcher substitutes a neutral
  /// default. Never 0 for a new seller, which would bury them permanently.
  responseRate  Float?
  leadsReceived Int    @default(0)
  leadsAccepted Int    @default(0)
  /// Cache of SUM(CreditLedger.delta). The ledger is the source of truth.
  creditBalance Int    @default(0)

  /// Denormalised from the active subscription's plan (D32), recomputed by
  /// `recomputeWebPresence` on every subscription write and swept nightly.
  /// Read on every microsite request, so it must not be a join.
  webPresence WebPresence @default(CATALOGUE)

  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  location      Location?           @relation(fields: [locationId], references: [id])
  members       SellerMember[]
  website       SellerWebsite?
  categories    SellerCategory[]
  serviceAreas  SellerServiceArea[]
  products      Product[]
  services      Service[]
  gallery       GalleryItem[]
  enquiries     Enquiry[]
  leads         Lead[]
  creditLedger  CreditLedger[]
  leadFlags     LeadFlag[]
  reviews       Review[]
  subscriptions Subscription[]
  documents     SellerDocument[]
  slugHistory   SellerSlugHistory[]
  events        AnalyticsEvent[]
  analytics     AnalyticsDaily[]
  payments      Payment[]
  carts         Cart[]
  orders        Order[]
  demandAlerts  DemandAlert[]
  integrations  SellerIntegration[]
  feature       SellerFeature?
  savedBy       SavedSeller[]
  // searchVector tsvector column + GIN index: see migration SQL.

  @@index([status, deletedAt])
  @@index([locationId, status])
  @@index([createdAt])
  @@index([ratingAvg(sort: Desc)])
  // Matcher's tie-break inside a category bucket.
  @@index([status, responseRate(sort: Desc)])
  @@index([webPresence])
}

/// Permanent 301 targets for renamed slugs. Never deleted — link equity depends
/// on old subdomains redirecting forever.
model SellerSlugHistory {
  id        String   @id @default(cuid())
  sellerId  String
  slug      String   @unique @db.Citext
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

/// KYC documents. PRIVATE bucket only — never public, never CDN-served.
/// Access is admin-only and audit-logged. See docs/SECURITY.md.
model SellerDocument {
  id           String           @id @default(cuid())
  sellerId     String
  type         DocumentType
  storageKey   String
  status       ModerationStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, type])
  @@index([status])
}

// ══════════════════════ WEBSITE / TEMPLATE ═══════════════════════════════════

/// Templates are code-registered (decision D7): `key` maps to a React component
/// in src/components/site/templates/registry.ts. No user-authored markup.
model WebsiteTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  previewImage  String?
  isPremium     Boolean  @default(false)
  isActive      Boolean  @default(true)
  /// Default themeTokens for this template, validated by Zod on read.
  defaultTokens Json
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  websites SellerWebsite[]
}

model SellerWebsite {
  id         String @id @default(cuid())
  sellerId   String @unique
  templateId String

  /// Zod-validated design tokens, emitted as CSS custom properties on <html>.
  /// Never interpolated into an unsanitised <style> block.
  themeTokens Json
  /// Per-section enable / order / config.
  sections    Json?

  // SEO overrides — fall back to computed defaults when null.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  gaMeasurementId String?

  /// Derived and persisted (decision D2) so robots.ts and generateMetadata
  /// never compute the gate at request time. Recomputed on every seller /
  /// product write and swept nightly by recompute-indexability.
  indexable        Boolean @default(false)
  indexBlockReason String?

  // Custom domains (decision D3) — resolver is built for these from day one,
  // provisioning ships in Phase 10.
  customDomain           String?      @unique @db.Citext
  customDomainStatus     DomainStatus @default(NONE)
  customDomainVerifiedAt DateTime?
  domainVerifyToken      String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  template WebsiteTemplate @relation(fields: [templateId], references: [id])

  @@index([indexable])
  @@index([customDomainStatus])
}

// ═══════════════════ TAXONOMY & GEOGRAPHY ════════════════════════════════════

/// Adjacency list + materialised path + ancestorIds array. The GIN index on
/// ancestorIds turns "everything in this subtree" into one indexed lookup
/// instead of a recursive CTE.
model Category {
  id          String   @id @default(cuid())
  parentId    String?
  slug        String   @db.Citext
  name        String
  description String?  @db.Text
  iconUrl     String?
  imageUrl    String?
  /// "/electronics/lighting/led-bulbs"
  path        String   @unique
  depth       Int      @default(0)
  ancestorIds String[]

  productCount Int     @default(0)
  sellerCount  Int     @default(0)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())

  parent       Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]       @relation("CategoryTree")
  products     Product[]
  services     Service[]
  sellers      SellerCategory[]
  requirements Requirement[]
  demandAlerts DemandAlert[]
  // name trigram index: see migration SQL.

  @@unique([parentId, slug])
  @@index([parentId, isActive, sortOrder])
  @@index([ancestorIds], type: Gin)
  @@index([depth])
}

/// One primary + up to four secondary categories per seller (Zod-enforced).
model SellerCategory {
  sellerId   String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([sellerId, categoryId])
  // Matcher prefers sellers whose PRIMARY category matches.
  @@index([categoryId, isPrimary])
}

/// Cities a seller serves beyond its own ("cities served" at onboarding).
model SellerServiceArea {
  sellerId   String
  locationId String
  createdAt  DateTime @default(now())

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([sellerId, locationId])
  // Matcher: "who serves this city?"
  @@index([locationId])
}

model Location {
  id          String       @id @default(cuid())
  parentId    String?
  type        LocationType
  slug        String       @db.Citext
  name        String
  /// "/in/maharashtra/mumbai"
  path        String       @unique
  ancestorIds String[]
  latitude    Float?
  longitude   Float?
  sellerCount Int          @default(0)
  isActive    Boolean      @default(true)
  /// Metro cluster for the lead matcher's city tier — "ncr" on Delhi,
  /// Gurugram, Noida, Faridabad, Ghaziabad. Null outside any cluster.
  clusterKey  String?

  metaTitle       String?
  metaDescription String?

  parent        Location?           @relation("LocationTree", fields: [parentId], references: [id])
  children      Location[]          @relation("LocationTree")
  sellers       Seller[]
  serviceAreas  SellerServiceArea[]
  buyerProfiles BuyerProfile[]
  requirements  Requirement[]
  pincodes      Pincode[]
  demandAlerts  DemandAlert[]

  @@unique([parentId, slug])
  @@index([type, isActive])
  @@index([ancestorIds], type: Gin)
  @@index([clusterKey])
}

/// India Post PIN codes, seeded NCR-first. Two jobs: resolve a pincode the
/// buyer typed into a city, and resolve browser lat/lng to the nearest known
/// pincode — which is why this exists instead of a paid geocoding API.
///
/// `locationId` is the city in the `Location` tree, so a pincode feeds the same
/// matcher as everything else. It is nullable: the dataset covers pincodes for
/// cities we have no `Location` row for yet.
model Pincode {
  pincode    String  @id
  city       String
  district   String?
  state      String
  locationId String?
  latitude   Float?
  longitude  Float?

  location Location? @relation(fields: [locationId], references: [id])

  @@index([city])
  @@index([locationId])
}

// ════════════════════════════ CATALOGUE ══════════════════════════════════════

model Product {
  id         String  @id @default(cuid())
  /// Tenant key. Every query from the dashboard is scoped by this via the
  /// Prisma client extension in src/lib/db-tenant.ts.
  sellerId   String
  categoryId String?
  slug       String  @db.Citext

  name             String
  shortDescription String?
  description      String? @db.Text
  brand            String?
  sku              String?
  modelNumber      String?

  // Pricing — integer minor units. Null means "ask for price".
  priceMinor     Int?
  priceMaxMinor  Int?
  currency       String  @default("INR")
  unit           String?
  minOrderQty    Int?
  priceOnRequest Boolean @default(true)

  /// [{ key, value }] — validated by Zod, length-capped.
  specifications Json?
  tags           String[]

  status           PublishStatus    @default(DRAFT)
  moderationStatus ModerationStatus @default(PENDING)
  isFeatured       Boolean          @default(false)
  viewCount        Int              @default(0)
  enquiryCount     Int              @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  seller       Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  enquiries    Enquiry[]
  requirements Requirement[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  // search_vector tsvector column + GIN index: see migration SQL.

  // Slug is unique per tenant, not globally — two sellers may both have
  // /products/led-panel-40w on their own subdomains.
  @@unique([sellerId, slug])
  @@index([sellerId, status, deletedAt])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([tags], type: Gin)
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  /// Denormalised from Product so upload-signing and tenant checks never need
  /// a join.
  sellerId  String

  provider    MediaProvider @default(CLOUDINARY)
  publicId    String
  url         String
  width       Int?
  height      Int?
  bytes       Int?
  mimeType    String?
  blurDataUrl String?
  alt         String?
  sortOrder   Int           @default(0)

  moderationStatus ModerationStatus @default(PENDING)
  createdAt        DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([sellerId])
}

model Service {
  id         String  @id @default(cuid())
  sellerId   String
  categoryId String?
  slug       String  @db.Citext

  name             String
  shortDescription String?
  description      String? @db.Text

  priceMinor     Int?
  currency       String  @default("INR")
  /// "hourly" | "fixed" | "quote"
  pricingModel   String?
  priceOnRequest Boolean @default(true)

  serviceAreas String[]
  deliverables Json?
  imageUrl     String?
  tags         String[]

  status           PublishStatus    @default(DRAFT)
  moderationStatus ModerationStatus @default(PENDING)
  isFeatured       Boolean          @default(false)
  viewCount        Int              @default(0)
  enquiryCount     Int              @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  seller    Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  enquiries Enquiry[]

  @@unique([sellerId, slug])
  @@index([sellerId, status, deletedAt])
  @@index([categoryId, status])
}

model GalleryItem {
  id       String @id @default(cuid())
  sellerId String

  provider    MediaProvider @default(CLOUDINARY)
  publicId    String
  url         String
  width       Int?
  height      Int?
  blurDataUrl String?
  title       String?
  caption     String?
  alt         String?
  sortOrder   Int           @default(0)

  moderationStatus ModerationStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, sortOrder])
}

// ══════════════════════════ DEMAND SIDE ══════════════════════════════════════

model Enquiry {
  id          String  @id @default(cuid())
  sellerId    String
  productId   String?
  serviceId   String?
  /// Null for anonymous enquiries, which is the common case.
  buyerUserId String?

  name     String
  email    String? @db.Citext
  phone    String?
  company  String?
  message  String  @db.Text
  quantity Int?

  source    EnquirySource
  status    EnquiryStatus @default(NEW)
  isSpam    Boolean       @default(false)
  spamScore Float?

  /// Metered-leads groundwork (decision D5). Unused in v1 — present so the
  /// switch to paid lead unlocks is a feature flag, not a migration.
  unlockedAt DateTime?

  // Attribution. ipHash is salted+hashed at write time — raw IPs are never
  // stored. Not exposed to the seller UI.
  ipHash      String?
  userAgent   String?
  referrer    String?
  landingPath String?

  respondedAt DateTime?
  sellerNote  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller  Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([createdAt])
}

model Review {
  id       String @id @default(cuid())
  sellerId String
  userId   String

  /// 1-5. Bounds enforced by a CHECK constraint in the migration SQL.
  rating      Int
  title       String?
  body        String?      @db.Text
  status      ReviewStatus @default(PENDING)
  sellerReply String?      @db.Text
  repliedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([sellerId, status, createdAt(sort: Desc)])
}

// ═══════════════════════ BUYERS & LEADS ══════════════════════════════════════
//
// A buyer creates an account (email + password verified by EmailOtp, or
// Google), states what they want (Requirement), and that requirement is shown
// to sellers as Leads: one DIRECT lead to the seller whose product was clicked,
// plus 0–10 MARKET leads fanned out asynchronously to matched sellers. State
// machines, masking and credit rules: docs/LEADS.md.

/// Buyer-side extension of `User`. The buyer's identity — email, password
/// hash, phone, phoneVerified — lives on `User`, which already carries all of
/// them; this row holds only what is specific to buying: the last location
/// they chose, used to pre-fill the requirement form and to match sellers.
///
/// `phoneVerified` on `User` stays null for now: buyers verify their email at
/// signup, and SMS verification is not in scope yet.
model BuyerProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  /// Last city the buyer chose. Mirrors the `bz_loc` cookie for guests.
  locationId String?
  /// As entered, six digits. `Pincode` resolves it to a city.
  pincode    String?
  /// Set only after the buyer grants browser geolocation.
  latitude   Float?
  longitude  Float?

  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

/// One row per OTP send. Only `codeHash` is stored — HMAC-SHA256 keyed by
/// OTP_PEPPER over `${phone}:${purpose}:${code}` — so a database dump alone
/// cannot be used to brute-force a 6-digit code offline. 5-minute expiry,
/// 3 attempts, single use. See src/lib/otp/challenge.ts.
model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  expiresAt   DateTime
  consumedAt  DateTime?
  ipHash      String?
  createdAt   DateTime   @default(now())

  // Verify path: latest open challenge for this phone + purpose.
  @@index([phone, purpose, createdAt(sort: Desc)])
  // Nightly prune.
  @@index([expiresAt])
}

/// Buyer email verification and password reset. Same storage rule as
/// `OtpChallenge` — only the HMAC of the code is kept, never the code itself —
/// but keyed on email and delivered by Resend. 10-minute expiry, 5 attempts.
model EmailOtp {
  id          String          @id @default(cuid())
  email       String          @db.Citext
  purpose     EmailOtpPurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  ipHash      String?
  createdAt   DateTime        @default(now())

  // Verify path: latest open code for this email + purpose.
  @@index([email, purpose, createdAt(sort: Desc)])
  // Nightly prune.
  @@index([expiresAt])
}

/// What the buyer wants. One Requirement → one DIRECT lead + 0–10 MARKET leads.
model Requirement {
  id             String  @id @default(cuid())
  /// The buyer's `User` row. Buyers are full accounts (email + password, or
  /// Google), so there is no separate buyer identity table.
  buyerId        String
  /// The product whose contact button was clicked. Null for "Post requirement".
  productId      String?
  /// Owner of that product — recipient of the DIRECT lead. Null for
  /// "Post requirement" (market-only). Denormalised so the fan-out can exclude
  /// this seller without joining Product, which may since have been deleted.
  directSellerId String?
  /// Matching key. Derived from product → category (falling back to the
  /// seller's primary category), or chosen by the buyer on "Post requirement".
  categoryId     String
  /// Buyer's city.
  locationId     String

  productName  String
  quantity     Int
  /// "pieces" | "kg" | "tonnes" | "metres" | ... from a fixed list.
  quantityUnit String
  timeline     RequirementTimeline
  purpose      RequirementPurpose
  notes        String?             @db.Text

  /// Collected only when purpose is RESALE or BUSINESS_USE.
  businessName String?
  gstin        String?
  /// As entered by the buyer; `locationId` is the city it resolved to.
  pincode      String?

  trigger RequirementTrigger
  source  RequirementSource
  /// Buyer arrived on the storefront from bzaro.in (`?ref=bzaro`, 30-day
  /// first-touch cookie). Drives the seller's "from Bzaro" attribution.
  refBzaro Boolean @default(false)

  /// Which consent text the buyer agreed to, and when. Versioned because the
  /// wording is what makes sharing the requirement with other sellers lawful —
  /// see src/lib/consent.ts.
  consentVersion String
  consentAt      DateTime

  /// sha256 of normalised productName + categoryId. Together with buyerId and
  /// createdAt this is the 7-day "same buyer, same requirement" dedupe key.
  fingerprint String

  // Async fan-out — DB-polled outbox drained by the worker.
  fanoutStatus   FanoutStatus @default(PENDING)
  fanoutAttempts Int          @default(0)
  fanoutAt       DateTime?
  fanoutError    String?

  // Attribution. Same rules as Enquiry: salted hash, never a raw IP.
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  category Category @relation(fields: [categoryId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  leads    Lead[]

  // Worker poll (a partial index on PENDING rows also exists — see SQL).
  @@index([fanoutStatus, createdAt])
  // 7-day dedupe.
  @@index([buyerId, fingerprint, createdAt(sort: Desc)])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([categoryId, locationId, createdAt(sort: Desc)])
}

/// A Requirement as seen by ONE seller. Masking is a read-time decision: the
/// buyer's phone is revealed when type = DIRECT or status = ACCEPTED. The
/// `masked` column is a CHECK-enforced invariant and a cheap filter for the
/// teaser UI, not the source of truth.
model Lead {
  id            String     @id @default(cuid())
  requirementId String
  sellerId      String
  type          LeadType
  status        LeadStatus @default(NEW)

  /// True until the seller accepts (MARKET). DIRECT is never masked.
  masked    Boolean
  /// Matcher output, kept for admin debugging and inbox ranking.
  score     Int?
  rank      Int?
  /// MARKET only: createdAt + leads.market.expiryHours. DIRECT never expires.
  expiresAt DateTime?

  viewedAt     DateTime?
  acceptedAt   DateTime?
  /// User who accepted (audit; the seller is `sellerId`).
  acceptedById String?
  closedAt     DateTime?
  sellerNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement   Requirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  deliveries    LeadDelivery[]
  flag          LeadFlag?
  creditEntries CreditLedger[]

  // A seller sees a requirement at most once.
  @@unique([requirementId, sellerId])
  // Inbox: default view.
  @@index([sellerId, status, createdAt(sort: Desc)])
  // Inbox: Direct / Market tabs.
  @@index([sellerId, type, status, createdAt(sort: Desc)])
  // Expiry sweeper: status IN (NEW, VIEWED) AND expiresAt < now().
  @@index([status, expiresAt])
  @@index([requirementId])
}

/// Outbox row per (lead, channel). The request path only ever inserts; the
/// worker drains PENDING rows through the LeadNotifier provider.
model LeadDelivery {
  id                String         @id @default(cuid())
  leadId            String
  channel           LeadChannel
  status            DeliveryStatus @default(PENDING)
  /// Name of the LeadNotifier that handled it: "console" | "whatsapp-cloud".
  provider          String?
  providerMessageId String?
  attempts          Int            @default(0)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, channel])
  // Worker poll (partial index on PENDING rows in SQL).
  @@index([status, createdAt])
}

/// Append-only. Balance = SUM(delta); Seller.creditBalance caches it.
model CreditLedger {
  id             String       @id @default(cuid())
  sellerId       String
  /// +10 monthly grant, -1 accept, +1 refund. Never 0.
  delta          Int
  balanceAfter   Int
  reason         CreditReason
  leadId         String?
  /// Set on FLAG_REFUND entries (LeadFlag.refundLedgerId points back).
  leadFlagId     String?
  subscriptionId String?
  /// "2026-09" on MONTHLY_GRANT. Unique with (sellerId, reason) so the monthly
  /// job is idempotent. Postgres treats NULLs as distinct, so the other reasons
  /// — which leave it null — are unaffected.
  periodKey      String?
  note           String?
  /// Admin user for ADMIN_ADJUST / FLAG_REFUND; null for system entries.
  actorId        String?
  createdAt      DateTime     @default(now())

  seller       Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([sellerId, reason, periodKey])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([leadId])
}

/// A seller disputes a MARKET lead after accepting. One flag per lead. An
/// admin resolves it; REFUNDED writes a FLAG_REFUND ledger entry.
model LeadFlag {
  id       String         @id @default(cuid())
  leadId   String         @unique
  sellerId String
  reason   LeadFlagReason
  note     String?        @db.Text
  status   LeadFlagStatus @default(OPEN)

  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  refundLedgerId String?   @unique
  createdAt      DateTime  @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Admin refund queue.
  @@index([status, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
}

// ══════════════════════ COMMERCE (STOREFRONTS ONLY) ══════════════════════════
//
// Carts and orders exist only on `{seller}.bzaro.in`, never on the apex, and
// only for sellers whose `SellerFeature.paymentsEnabled` is true with a working
// Razorpay integration. The apex guard lives in the route handlers, not just in
// the UI. A checkout produces an Order for that one seller — never a lead — and
// anonymous DemandAlerts for the others.
//
// Money is integer minor units throughout, as everywhere else in this schema.

/// One cart per buyer per store. Server-side, so it survives devices.
model Cart {
  id        String   @id @default(cuid())
  sellerId  String
  buyerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@unique([sellerId, buyerId])
  @@index([buyerId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  /// Snapshot taken when the item was added, so a price change mid-session
  /// cannot silently move the total. Re-validated at checkout.
  priceMinor Int
  currency   String @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

/// A paid (or COD) order against exactly one seller. Appears in that seller's
/// Orders tab and nowhere else.
model Order {
  id          String @id @default(cuid())
  /// Buyer-facing reference, e.g. "BZ-2K4X9A". Unique platform-wide.
  orderNumber String @unique
  sellerId    String
  buyerId     String

  subtotalMinor Int
  shippingMinor Int    @default(0)
  taxMinor      Int    @default(0)
  totalMinor    Int
  currency      String @default("INR")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  /// "razorpay" | "cod"
  paymentMethod String?

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  shippingStatus    ShippingStatus @default(NOT_SHIPPED)
  shiprocketOrderId String?
  awb               String?
  trackingUrl       String?

  /// Snapshot at checkout — { name, line1, line2, city, state, pincode,
  /// phone }, validated by Zod. Never a live FK: an address edited later must
  /// not rewrite history on a shipped order.
  shippingAddress Json
  buyerName       String
  buyerEmail      String? @db.Citext
  buyerPhone      String?

  placedAt  DateTime  @default(now())
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  seller Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User        @relation(fields: [buyerId], references: [id])
  items  OrderItem[]

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  /// Null once the product is deleted; the snapshot below is what the order
  /// actually was.
  productId String?

  name           String
  sku            String?
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int
  currency       String  @default("INR")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// "Someone in your city ordered this" — sent to other matched sellers when an
/// order is paid. Deliberately carries NO buyer column of any kind: an exact
/// quantity plus a timestamp would re-identify the order, which is why the
/// quantity is banded. See docs/LEADS.md §7.
model DemandAlert {
  id          String @id @default(cuid())
  /// Recipient.
  sellerId    String
  categoryId  String
  locationId  String
  productName String
  /// Bucket label from a fixed list, e.g. "11-50". Never an exact quantity.
  quantityBand String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  // Unread badge.
  @@index([sellerId, readAt])
  @@index([sellerId, createdAt(sort: Desc)])
}

/// Sellers a buyer keeps for later (Phase 7).
///
/// Buyer-owned, not seller-owned: it is read from the buyer's side ("my saved
/// suppliers"), so it deliberately stays OUT of `TENANT_MODELS` — scoping it by
/// sellerId would make the buyer's own list unqueryable.
model SavedSeller {
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())

  buyer  User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([buyerId, sellerId])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId])
}

/// A seller's own Razorpay / Shiprocket credentials. Bzaro never holds the
/// money: the keys belong to the seller's account.
model SellerIntegration {
  id       String          @id @default(cuid())
  sellerId String
  type     IntegrationType
  enabled  Boolean         @default(false)
  mode     IntegrationMode @default(TEST)

  /// AES-256-GCM ciphertext under INTEGRATIONS_ENCRYPTION_KEY. Never returned
  /// to a client, never logged, never in a server-component payload.
  encryptedConfig String @db.Text
  /// Non-secret display hints only, e.g. { keyIdLast4: "9f21" }, so the
  /// settings screen can render ••••9f21 without decrypting anything.
  configHint      Json?

  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, type])
}

/// Which paid capabilities a seller has. Written by the plan sweep, the add-on
/// purchase flow, or an admin override — `source` records which, and
/// ADMIN_OVERRIDE is never revoked by the sweep.
model SellerFeature {
  sellerId        String        @id
  paymentsEnabled Boolean       @default(false)
  shippingEnabled Boolean       @default(false)
  source          FeatureSource @default(PLAN)
  note            String?
  /// Admin who last changed it, for the audit trail.
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════ MONETISATION ════════════════════════════════════

model Plan {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  description String?
  priceMinor  Int             @default(0)
  currency    String          @default("INR")
  interval    BillingInterval @default(MONTHLY)
  trialDays   Int             @default(0)

  // Quotas — enforced by PlanGuard before every create.
  maxProducts         Int  @default(10)
  maxServices         Int  @default(5)
  maxGalleryItems     Int  @default(10)
  maxCategories       Int  @default(3)
  /// Market-lead credits granted on the 1st of each month (docs/LEADS.md).
  /// Null = unlimited. DIRECT leads never consume credits.
  leadCreditsPerMonth Int?

  // Feature flags
  /// The web-presence tier this plan buys (D32).
  webPresence           WebPresence @default(CATALOGUE)
  allowPremiumTemplates Boolean @default(false)
  removeBranding        Boolean @default(false)
  prioritySupport       Boolean @default(false)
  searchBoost           Int     @default(0)
  features              Json?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id       String    @id @default(cuid())
  sellerId String
  planId   String
  status   SubStatus @default(TRIALING)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  trialEndsAt        DateTime?
  gracePeriodEndsAt  DateTime?

  /// DEPRECATED — superseded by CreditLedger (docs/LEADS.md). Never written.
  leadCreditsUsed Int @default(0)

  gatewayCustomerId     String?
  gatewaySubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller       Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan         Plan           @relation(fields: [planId], references: [id])
  payments     Payment[]
  creditLedger CreditLedger[]

  @@index([sellerId, status])
  @@index([status, currentPeriodEnd])
}

model Payment {
  id             String @id @default(cuid())
  subscriptionId String
  sellerId       String

  amountMinor      Int
  currency         String    @default("INR")
  status           String
  gatewayPaymentId String?   @unique
  invoiceNumber    String?   @unique
  invoiceUrl       String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  seller       Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt(sort: Desc)])
}

/// Webhook idempotency. Payment gateways retry aggressively; the unique
/// constraint on (provider, eventId) makes replays provable no-ops.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}

// ═══════════════════════ ANALYTICS & AUDIT ═══════════════════════════════════

/// Append-only. PARTITIONED BY RANGE (createdAt) — see migration SQL.
/// Raw rows are pruned at 90 days; AnalyticsDaily is the permanent record.
model AnalyticsEvent {
  /// Composite primary key: Postgres requires the partition key to be part of
  /// every unique constraint on a partitioned table. `id` alone is still
  /// effectively unique (cuid), but `createdAt` must ride along.
  id         String  @default(cuid())
  sellerId   String
  /// page_view | product_view | whatsapp_click | phone_reveal | enquiry_submit
  type       String
  entityType String?
  entityId   String?
  path       String?
  referrer   String?
  country    String?
  city       String?
  deviceType String?
  sessionId  String?
  ipHash     String?
  metadata   Json?

  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([sellerId, type, createdAt])
  @@index([createdAt])
}

model AnalyticsDaily {
  id       String   @id @default(cuid())
  sellerId String
  date     DateTime @db.Date

  pageViews      Int @default(0)
  uniqueVisitors Int @default(0)
  productViews   Int @default(0)
  enquiries      Int @default(0)
  whatsappClicks Int @default(0)
  phoneReveals   Int @default(0)

  /// Top pages, referrers, cities.
  breakdown Json?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, date])
  @@index([date])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  actorRole UserRole?
  sellerId  String?
  /// "seller.verify", "product.delete", "enquiry.export"
  action    String

  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

/// Runtime-tunable platform configuration (indexability thresholds, feature
/// flags, rate-limit overrides). Read through src/lib/settings.ts.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
