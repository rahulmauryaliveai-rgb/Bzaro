# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template must stay tracked (see .env.example)
!.env.example

# Prisma generated client (regenerated by `npm run db:generate`)
/src/generated

# Playwright / test output
/test-results
/playwright-report
/.playwright

# Local media provider output (development only; see src/lib/media/local.ts)
/public/uploads/

# Local-only Playwright override (browser channel); see tests/e2e
playwright.local.config.ts

# Showcase seed output (prisma/seed/showcase.ts)
demo-credentials.txt
.demo-credentials.tmp

# Openverse search cache + review sheets for scripts/demo-images.ts
scripts/demo-images/candidates.json
scripts/demo-images/search.log
scripts/demo-images/sheet-*.jpg
