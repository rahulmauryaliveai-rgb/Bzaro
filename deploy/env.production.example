# /srv/bzaro/app/.env — the ONE environment file on the VPS.
# Read by Next.js (build + start), the Prisma CLI, the lead worker, the seeds
# and deploy/cron-run.sh. Never commit it. setup-vps.sh generates the secrets.

NODE_ENV="production"

# ── Domain ──────────────────────────────────────────────────────────────────
# No protocol, no port. Every tenant URL is derived from this (src/lib/utils/url.ts).
NEXT_PUBLIC_ROOT_DOMAIN="bzaro.in"
NEXT_PUBLIC_PROTOCOL="https"
NEXT_PUBLIC_PLATFORM_NAME="Bzaro"
AUTH_URL="https://bzaro.in"
AUTH_TRUST_HOST="true"

# ── Database (deploy/compose.yml postgres) ──────────────────────────────────
# Same password as POSTGRES_PASSWORD in deploy/.env. No pooler on a single
# box, so both URLs are the same.
DATABASE_URL="postgres://bzaro:__POSTGRES_PASSWORD__@127.0.0.1:5432/bzaro"
DIRECT_DATABASE_URL="postgres://bzaro:__POSTGRES_PASSWORD__@127.0.0.1:5432/bzaro"

# ── Rate limiting (deploy/compose.yml redis-http) ───────────────────────────
# Token must equal SRH_TOKEN in deploy/.env.
UPSTASH_REDIS_REST_URL="http://127.0.0.1:8079"
UPSTASH_REDIS_REST_TOKEN="__SRH_TOKEN__"

# ── Secrets (openssl rand -base64 48) — all distinct ────────────────────────
AUTH_SECRET="__GENERATE__"
OTP_PEPPER="__GENERATE__"
REVALIDATE_SECRET="__GENERATE__"
CRON_SECRET="__GENERATE__"
IP_HASH_SALT="__GENERATE__"

# ── Uploads ─────────────────────────────────────────────────────────────────
# Seller logos / product photos go to public/uploads on this disk and are
# served by Caddy. Switch to Cloudinary later by filling the three values
# below and removing MEDIA_LOCAL_UPLOADS.
MEDIA_LOCAL_UPLOADS="1"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (Resend) — REQUIRED for buyers to sign up ────────────────────────
# Buyers verify their email with a 6-digit code (D35). Without a key the code
# is only written to the pm2 log, which means NOBODY CAN CREATE AN ACCOUNT and
# the lead funnel is dead. Verify a sending domain, then fill both in.
RESEND_API_KEY=""
MAIL_FROM="Bzaro <no-reply@mail.bzaro.in>"

# ── Seller payment / shipping credentials — REQUIRED for payments ──────────
# AES-256-GCM key protecting each seller's own Razorpay and Shiprocket keys.
# Must decode to exactly 32 bytes:  openssl rand -base64 32
# Without it no seller can save credentials, so carts and checkout stay off.
# Rotating this makes every already-stored credential unreadable.
INTEGRATIONS_ENCRYPTION_KEY="__GENERATE_32__"

# ── Cloudflare Turnstile — optional ────────────────────────────────────────
# Unset means the signup captcha is not enforced at all. Once the SECRET is
# set it fails CLOSED: a missing or rejected token is refused, including when
# Cloudflare itself is unreachable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# ── WhatsApp Cloud API — optional; without it OTPs/alerts are logged ───────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Google sign-in — optional ───────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── First administrator (used once by `npm run db:seed:prod`) ──────────────
ADMIN_EMAIL="you@bzaro.in"
ADMIN_PASSWORD="__CHOOSE_A_LONG_PASSWORD__"
