# Bzaro edge (deploy/compose.yml → stock caddy:2 image, host network).
#
# Certificates are issued ON DEMAND: the apex and www at startup, and every
# seller subdomain the first time a browser asks for it, via the HTTP-01
# challenge on port 80. No DNS-provider API is needed — the `*` A record at
# the registrar is enough. Before issuing, Caddy asks the app whether the
# hostname belongs to a seller (src/app/api/tls/ask), so strangers cannot
# burn the ACME rate limit with made-up subdomains.
#
# Cost of this design: a never-visited subdomain answers its very first
# request ~2–5 s late while the certificate is obtained; every request after
# that is instant. Switching to a true wildcard later only needs a DNS
# provider module (docs/DEPLOYMENT.md §3) — the app does not change.
#
# Variables come from deploy/.env via compose.yml.

{
	email {$ACME_EMAIL}
	# No HTTP/3: UDP 443 is not open, and an Alt-Svc h3 header leaking through
	# Cloudflare makes Chrome attempt QUIC and fail (ERR_QUIC_PROTOCOL_ERROR).
	servers {
		protocols h1 h2
		# Real client IP. Only a connection FROM a Cloudflare range may tell us
		# the visitor's address (CF-Connecting-IP); anyone else — the raw IP, a
		# seller's custom domain — gets their TCP peer address, whatever headers
		# they send. The result is {client_ip}, handed to the app as X-Real-IP.
		# Ranges: https://www.cloudflare.com/ips — deploy/check-cloudflare-ips.sh
		# (weekly cron) warns when they change.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
	on_demand_tls {
		ask http://127.0.0.1:3000/api/tls/ask
	}
}

# Authenticated Origin Pulls (mTLS): only Cloudflare can complete a TLS
# handshake for bzaro.in hosts, so the origin cannot be reached around
# Cloudflare (its WAF, the Turnstile/rate-limit edge, spoofed CF-* headers).
# The CA is Cloudflare's public origin-pull CA, stored in the caddy-data volume.
# ORDER MATTERS: switch AOP on in Cloudflare (SSL/TLS → Origin Server) BEFORE
# deploying this, or Cloudflare presents no client certificate and every
# bzaro.in host fails with 525. Seller custom domains (on-demand TLS) are
# not behind Cloudflare and do not use this.
(cloudflare_mtls) {
	client_auth {
		mode require_and_verify
		trust_pool file /data/cloudflare/origin-pull-ca.pem
	}
}

# `import app <port> <uploads dir>` — the live site passes 3000 /srv/uploads,
# the sales demo (deploy/setup-demo.sh) 3001 /srv/uploads-demo.
(app) {
	encode zstd gzip

	# Seller media uploaded through the app lives on the host disk
	# (public/uploads). Files are UUID-named, so they can be cached forever.
	handle_path /uploads/* {
		root * {args[1]}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the Next.js server (pm2 "bzaro-web"). The Host header
	# is passed through untouched — src/proxy.ts resolves the tenant from it.
	handle {
		reverse_proxy 127.0.0.1:{args[0]} {
			header_up X-Forwarded-Proto https
			# OVERWRITE, never append: a client-supplied X-Real-IP or
			# X-Forwarded-For must not reach the rate limiter
			# (src/lib/ratelimit.ts getClientIp reads X-Real-IP only).
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Next.js sets its own security headers; do not cache HTML here.
	log {
		output stderr
		format console
	}
}

# The marketplace. Same Cloudflare Origin Certificate as the subdomains:
# browsers only ever see Cloudflare's edge certificate, and this removes the
# Let's Encrypt renewal (HTTP-01 through the proxy) the apex used to depend on.
{$ROOT_DOMAIN} {
	tls /data/cloudflare/bzaro-origin.pem /data/cloudflare/bzaro-origin.key {
		import cloudflare_mtls
	}
	import app 3000 /srv/uploads
}

# Every seller website: certificate obtained at first request, gated by /api/tls/ask.
# www lives here too (a separate site block would be skipped by Caddy as
# "covered by the wildcard" and never get a certificate): it is issued on demand
# like any subdomain, then redirected to the apex — one canonical host for SEO.
*.{$ROOT_DOMAIN} {
	# Seller subdomains use the Cloudflare Origin Certificate (bzaro.in + *.bzaro.in,
	# valid to 2041). On-demand Let's Encrypt cannot complete behind the Cloudflare
	# proxy and left every subdomain on error 525. Files live in the caddy-data
	# volume at /data/cloudflare/ (copied from /etc/ssl/cloudflare/ on the VPS).
	tls /data/cloudflare/bzaro-origin.pem /data/cloudflare/bzaro-origin.key {
		import cloudflare_mtls
	}
	@www host www.{$ROOT_DOMAIN}
	redir @www https://{$ROOT_DOMAIN}{uri} permanent
	import app 3000 /srv/uploads
}

# Extra sites that live outside this repo's release cycle — today the sales
# demo, written by deploy/setup-demo.sh into /srv/bzaro/shared/caddy-sites/.
# No files is fine: Caddy only warns.
import /etc/caddy/sites/*.caddy
