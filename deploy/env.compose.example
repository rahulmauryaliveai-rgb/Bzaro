# deploy/.env — read by `docker compose --env-file deploy/.env`.
# setup-vps.sh writes this file; edit CLOUDFLARE_API_TOKEN and ACME_EMAIL.

ROOT_DOMAIN=bzaro.in
ACME_EMAIL=you@bzaro.in

# Cloudflare API token with Zone:DNS:Edit on the bzaro.in zone (docs/HOSTINGER.md §2).
CLOUDFLARE_API_TOKEN=

# Must match the values inside /srv/bzaro/app/.env
POSTGRES_PASSWORD=
SRH_TOKEN=
