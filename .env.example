# ─────────────────────────────────────────────────────────────────────────────
# Seller Marketplace — environment template
#
# Copy to `.env.local` for development:   cp .env.example .env.local
# Every variable here is validated at boot by `src/env.ts`. A missing or
# malformed required value fails the build rather than surfacing at runtime.
#
# NEVER commit `.env.local` or `.env`. Only this template is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# Root domain WITHOUT protocol. Include the port in development, omit in prod.
#   dev  → lvh.me:3000
#   prod → bzaro.in
# The proxy strips the port from the Host header before comparing, but every
# generated URL is built from this value — see src/lib/utils/url.ts.
NEXT_PUBLIC_ROOT_DOMAIN="lvh.me:3000"
NEXT_PUBLIC_PROTOCOL="http"
NEXT_PUBLIC_PLATFORM_NAME="Bzaro"

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL       → pooled (PgBouncer, transaction mode). Used by the app.
# DIRECT_DATABASE_URL → direct connection. Used by `prisma migrate` ONLY.
# In local dev both point at the same server.
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"
DIRECT_DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"

# ── Auth.js v5 ───────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical origin of the auth routes. Apex only — never a tenant subdomain.
AUTH_URL="http://lvh.me:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (optional in development — leave blank to disable the provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Optional in development: when unset, the limiter falls back to an in-memory
# implementation so local work does not require a Redis instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Media (Cloudinary) ───────────────────────────────────────────────────────
# Uploads fall back to local disk (public/uploads) when these are unset, so the
# catalogue is usable with no Cloudinary account. That fallback is DEVELOPMENT
# ONLY — in production without these three, uploads are refused outright rather
# than written to an ephemeral filesystem. See D27.
#
# CLOUDINARY_API_SECRET is server-only and must never be exposed to the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Buyer OTP + lead notifications ───────────────────────────────────────────
# Both fall back to console providers when unset (codes and lead alerts print
# to the server log). Production boots without WHATSAPP_* but logs an error.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Keys OTP code hashes. Required in production, min 32 chars.
#   openssl rand -base64 32
OTP_PEPPER=""
# Signs the buyer identity cookie minted after OTP verification. Required in
# production, min 32 chars. Use a different value from OTP_PEPPER.
BUYER_COOKIE_SECRET=""

# ── Internal ─────────────────────────────────────────────────────────────────
# Shared secret guarding /api/revalidate and cron job handlers.
REVALIDATE_SECRET=""
# Salt for hashing visitor IPs before they touch the database. Rotate quarterly.
IP_HASH_SALT=""
