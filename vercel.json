{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/rollup-analytics",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/recompute-indexability",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/refresh-counters",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/prune-events",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/cron/create-partitions",
      "schedule": "0 5 25 * *"
    },
    {
      "path": "/api/cron/expire-market-leads",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/cron/grant-monthly-credits",
      "schedule": "15 0 1 * *"
    },
    {
      "path": "/api/cron/refresh-lead-stats",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/recompute-web-presence",
      "schedule": "50 3 * * *"
    }
  ]
}
